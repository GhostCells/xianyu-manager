# Stage dedicated users, preparation assets and X authority in approved window.
XIANYU_MANAGER_PREPARE_MODE=true
XIANYU_MANAGER_SAFE_MODE=false
XIANYU_MANAGER_ACCOUNT_ID=
XIANYU_MANAGER_LOGIN_AUTHORIZED=false
XIANYU_MANAGER_EGRESS_STATUS_PATH=/run/xianyu-egress/status.json
XIANYU_MANAGER_API_UDS=/run/xianyu-runtime/api.sock
XIANYU_MANAGER_DATA_DIR=/var/lib/xianyu-runtime/data
XIANYU_PRODUCT_LIBRARY_DIR=/var/lib/xianyu-runtime/assets/library
XIANYU_PRODUCT_VALIDATOR_PATH=/var/lib/xianyu-runtime/assets/validator.py
XIANYU_BROWSER_EXECUTABLE=/usr/bin/google-chrome-stable
XIANYU_BROWSER_HEADLESS=false
DISPLAY=:99
XAUTHORITY=/var/lib/xianyu-runtime/Xauthority
PYTHONPATH=/opt/xianyu-manager/src
PYTHONDONTWRITEBYTECODE=1
