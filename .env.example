# Runtime data directory (SQLite, browser profiles, locks, and logs)
# Default false preserves normal production account/automation recovery.
# Set true for migration rehearsal; fixed until process restart, no business IO.
XIANYU_MANAGER_SAFE_MODE=false

# Explicit preparation policy; SAFE_MODE has priority. Restart to change policy.
# Leave these defaults unchanged for the existing Windows normal runtime.
XIANYU_MANAGER_PREPARE_MODE=false
XIANYU_MANAGER_ACCOUNT_ID=
XIANYU_MANAGER_LOGIN_AUTHORIZED=false
XIANYU_MANAGER_EGRESS_STATUS_PATH=

XIANYU_MANAGER_DATA_DIR=/path/to/runtime-data

# Chrome or Chromium executable on the deployment host
XIANYU_BROWSER_EXECUTABLE=/path/to/chrome

# Keep false for the planned Xvfb + headful Chrome deployment
XIANYU_BROWSER_HEADLESS=false

# External production assets; do not place them in this repository
XIANYU_PRODUCT_LIBRARY_DIR=/path/to/product-library
XIANYU_PRODUCT_VALIDATOR_PATH=/path/to/private-validator.py

# Normal production only: supply through a permission-protected EnvironmentFile.
# Preparation deployment must OMIT this variable; never configure a real key.
SILICONFLOW_API_KEY=replace-with-secret-at-deployment
